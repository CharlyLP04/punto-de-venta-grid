{
  "name": "mario-pos-gridmx",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "tauri": "tauri",
    "desktop": "tauri dev",
    "installer": "tauri build",
    "desktop:update": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/update-desktop.ps1",
    "desktop:watch": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/update-desktop.ps1 -Watch",
    "test": "npm run test:native && npm run test:ui",
    "test:native": "cargo test --manifest-path src-tauri/Cargo.toml",
    "test:ui": "playwright test"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/vite": "^4.0.0",
    "@tauri-apps/cli": "^2.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.0.0",
    "typescript": "~5.7.2",
    "vite": "^6.0.0"
  }
}
